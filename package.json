{
  "name": "veritas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI 事实核查工作台 — 逐段取证，输出可信度评分与 Markdown 报告",
  "homepage": "https://kkai726.github.io/veritas/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kkai726/veritas.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "electron": "npm run build && electron .",
    "app:win": "npm run build && electron-builder --win",
    "app:android": "npm run build && cd android && ./build.sh"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.kkai.veritas",
    "productName": "Veritas",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Veritas"
    },
    "asar": true
  }
}
